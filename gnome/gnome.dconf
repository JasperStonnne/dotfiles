[Ptyxis]
default-profile-uuid='8c8215ea3b407db38f87157a69ef238a'
profile-uuids=['8c8215ea3b407db38f87157a69ef238a']
window-size=(uint32 155, uint32 72)

[control-center]
last-panel='display'
window-state=(980, 640, false)

[desktop/app-folders]
folder-children=['System', 'Utilities', 'YaST', 'Pardus']

[desktop/app-folders/folders/Pardus]
categories=['X-Pardus-Apps']
name='X-Pardus-Apps.directory'
translate=true

[desktop/app-folders/folders/System]
apps=['nm-connection-editor.desktop', 'org.gnome.baobab.desktop', 'org.gnome.DiskUtility.desktop', 'im-config.desktop', 'org.gnome.Logs.desktop', 'org.gnome.Sysprof.desktop']
name='X-GNOME-Shell-System.directory'
translate=true

[desktop/app-folders/folders/Utilities]
apps=['org.gnome.Papers.desktop', 'org.gnome.font-viewer.desktop', 'org.gnome.Loupe.desktop', 'org.gnome.seahorse.Application.desktop']
name='X-GNOME-Shell-Utilities.directory'
translate=true

[desktop/app-folders/folders/YaST]
categories=['X-SuSE-YaST']
name='suse-yast.directory'
translate=true

[desktop/input-sources]
mru-sources=[('xkb', 'us')]
sources=[('xkb', 'us')]

[desktop/interface]
accent-color='purple'
color-scheme='default'
gtk-theme='Yaru-purple'
icon-theme='Yaru-purple'

[desktop/notifications]
application-children=['qq', 'org-gnome-nautilus', 'google-chrome', 'org-gnome-ptyxis', 'org-gnome-texteditor', 'firefox-firefox', 'clash-verge']

[desktop/notifications/application/clash-verge]
application-id='Clash Verge.desktop'

[desktop/notifications/application/firefox-firefox]
application-id='firefox_firefox.desktop'

[desktop/notifications/application/google-chrome]
application-id='google-chrome.desktop'

[desktop/notifications/application/org-gnome-nautilus]
application-id='org.gnome.Nautilus.desktop'

[desktop/notifications/application/org-gnome-ptyxis]
application-id='org.gnome.Ptyxis.desktop'

[desktop/notifications/application/org-gnome-texteditor]
application-id='org.gnome.TextEditor.desktop'

[desktop/notifications/application/qq]
application-id='qq.desktop'

[desktop/privacy]
report-technical-problems=false

[evolution-data-server]
migrated=true

[mutter]
edge-tiling=false

[mutter/keybindings]
toggle-tiled-left=@as []
toggle-tiled-right=@as []

[mutter/wayland]
xwayland-scaling-factor=1.0

[nautilus/preferences]
migrated-gtk-settings=true

[nautilus/window-state]
initial-size=(890, 550)
maximized=false

[settings-daemon/plugins/color]
night-light-enabled=true
night-light-schedule-automatic=false
night-light-temperature=uint32 4700

[settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/flameshot/']

[settings-daemon/plugins/media-keys/custom-keybindings/flameshot]
binding='<Super>s'
command='flameshot gui'
name='Flameshot'

[shell]
app-picker-layout=[{'org.gnome.Calculator.desktop': <{'position': <0>}>, 'firmware-updater_firmware-updater.desktop': <{'position': <1>}>, 'gnome-language-selector.desktop': <{'position': <2>}>, 'org.gnome.clocks.desktop': <{'position': <3>}>, 'net.nokyan.Resources.desktop': <{'position': <4>}>, 'desktop-security-center_desktop-security-center.desktop': <{'position': <5>}>, 'update-manager.desktop': <{'position': <6>}>, 'org.gnome.Settings.desktop': <{'position': <7>}>, 'org.gnome.Ptyxis.desktop': <{'position': <8>}>, 'org.gnome.TextEditor.desktop': <{'position': <9>}>, 'org.gnome.Characters.desktop': <{'position': <10>}>, 'Utilities': <{'position': <11>}>, 'System': <{'position': <12>}>, 'org.fcitx.Fcitx5.desktop': <{'position': <13>}>, 'firefox_firefox.desktop': <{'position': <14>}>, 'fcitx5-configtool.desktop': <{'position': <15>}>, 'org.fcitx.fcitx5-migrator.desktop': <{'position': <16>}>, 'kbd-layout-viewer5.desktop': <{'position': <17>}>}]
enabled-extensions=['ding@rastersoft.com', 'ubuntu-dock@ubuntu.com', 'tiling-assistant@ubuntu.com']
favorite-apps=['org.gnome.Nautilus.desktop', 'snap-store_snap-store.desktop', 'org.gnome.Yelp.desktop', 'google-chrome.desktop', 'qq.desktop', 'CC Switch.desktop', 'wechat.desktop', 'Clash Verge.desktop']
welcome-dialog-last-shown-version='50.1'

[shell/extensions/dash-to-dock]
dash-max-icon-size=32

[shell/extensions/ding]
check-x11wayland=true

[shell/extensions/tiling-assistant]
focus-hint-color='rgb(203,67,20)'
last-version-installed=54
overridden-settings={'org.gnome.mutter.edge-tiling': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-left': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-right': <@mb nothing>}
tiling-popup-all-workspace=true

[shell/world-clocks]
locations=@av []

[system/location]
enabled=false
